@code
{
    private string Name;
    private string MobileNumber;
    private string Service;
    private string Comment;
    
    public class ContactForm
    {
        public ContactForm(string name, string mobileNumber, string service, string comment)
        {
            Name = name;
            MobileNumber = mobileNumber;
            Service = service;
            Comment = comment;
        }

        public string Name { get; set; }
    
        public string MobileNumber { get; set; }
    
        public string Service { get; set; }
    
        public string Comment { get; set; }
    }
    
    private async Task SendMail()
    {
        string url = "https://carpet-cleaning-backend.azurewebsites.net/";
        
        using HttpClient client = new HttpClient();

        client.BaseAddress = new Uri(url);

        ContactForm form = new ContactForm(Name, MobileNumber, Service, Comment);

        var json = JsonSerializer.Serialize(form);
        var content = new StringContent(json, Encoding.UTF8, "application/json");

        var response = await client.PostAsync("home", content);


        if (response.IsSuccessStatusCode)
        {
            var responseContent = response.Content.ReadAsStringAsync().Result;
            Debug.WriteLine("oldu");
        }
        else
        {
            Debug.WriteLine("error");
        }
    }
}
